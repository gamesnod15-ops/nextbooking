NEXT_PUBLIC_API_URL=http://localhost:5280
NEXT_PUBLIC_BUSINESS_PANEL_URL=http://localhost:3000

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Authorized redirect URI must include:
#   <site-origin>/auth/oauth/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Apple Developer → Certificates, IDs & Profiles → Identifiers → Services ID.
# Return URL must include:
#   <site-origin>/auth/oauth/apple/callback
NEXT_PUBLIC_APPLE_CLIENT_ID=
