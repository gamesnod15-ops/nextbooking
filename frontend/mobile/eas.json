{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "43393257962-egpn5rrj6comvq2lmkfirokhdegj4ngb.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "43393257962-egpn5rrj6comvq2lmkfirokhdegj4ngb.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
