# Copy to .env and adjust. Values here are read by app.config.ts at build time.
#
# Which built-in profile to use when EXPO_PUBLIC_API_URL is not set.
# One of: development | staging | production
APP_ENV=production

# Explicit API base URL. Overrides the profile default above.
# Local API example:
# EXPO_PUBLIC_API_URL=http://localhost:5280/api/v1
# Android emulator reaching the host machine:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5280/api/v1
